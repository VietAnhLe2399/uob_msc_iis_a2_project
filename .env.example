# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=replay        # replay | gemini | groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash   # model names change over time; check AI Studio
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile   # check console.groq.com/docs/models
PROMPT_VERSION=v4   # v1 base; v2 + claim definitions; v3 + what counts as a profile change; v4 + requested_focus / adjustment_note
